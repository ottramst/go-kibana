[
  {
    "action_groups": [
      {
        "id": "threshold met",
        "name": "Threshold met"
      },
      {
        "id": "recovered",
        "name": "Recovered"
      }
    ],
    "action_variables": {
      "context": [
        {
          "name": "message",
          "description": "A pre-constructed message for the alert."
        },
        {
          "name": "title",
          "description": "A pre-constructed title for the alert."
        },
        {
          "name": "group",
          "description": "The group that exceeded the threshold."
        },
        {
          "name": "date",
          "description": "The date the alert met the threshold conditions."
        },
        {
          "name": "value",
          "description": "The value that exceeded the threshold."
        },
        {
          "name": "conditions",
          "description": "A string describing the threshold comparator and threshold."
        }
      ],
      "state": [],
      "params": [
        {
          "name": "threshold",
          "description": "An array of rule threshold values. For between and notBetween thresholds, there are two values."
        },
        {
          "name": "thresholdComparator",
          "description": "The comparison function for the threshold."
        },
        {
          "name": "index",
          "description": "The indices the rule queries."
        },
        {
          "name": "timeField",
          "description": "The field that is used to calculate the time window."
        },
        {
          "name": "aggType",
          "description": "The type of aggregation."
        },
        {
          "name": "aggField",
          "description": "The field that is used in the aggregation."
        },
        {
          "name": "groupBy",
          "description": "Indicates whether the aggregation is applied over all documents or split into groups."
        },
        {
          "name": "termField",
          "description": "The field that is used for grouping the aggregation."
        },
        {
          "name": "filterKuery",
          "description": "A KQL expression that limits the scope of alerts."
        },
        {
          "name": "termSize",
          "description": "The number of groups that are checked against the threshold."
        },
        {
          "name": "timeWindowSize",
          "description": "The size of the time window, which determines how far back to search for documents."
        },
        {
          "name": "timeWindowUnit",
          "description": "The type of units for the time window: seconds, minutes, hours, or days."
        }
      ]
    },
    "alerts": {
      "context": "stack",
      "mappings": {
        "fieldMap": {
          "kibana.alert.title": {
            "type": "keyword",
            "array": false,
            "required": false
          },
          "kibana.alert.evaluation.conditions": {
            "type": "keyword",
            "array": false,
            "required": false
          },
          "kibana.alert.evaluation.value": {
            "type": "keyword",
            "array": false,
            "required": false
          },
          "kibana.alert.evaluation.threshold": {
            "type": "scaled_float",
            "scaling_factor": 100,
            "required": false
          },
          "kibana.alert.grouping": {
            "type": "object",
            "dynamic": true,
            "array": false,
            "required": false
          }
        },
        "dynamicTemplates": [
          {
            "strings_as_keywords": {
              "path_match": "kibana.alert.grouping.*",
              "match_mapping_type": "string",
              "mapping": {
                "type": "keyword",
                "ignore_above": 1024
              }
            }
          }
        ]
      },
      "shouldWrite": true,
      "useEcs": true
    },
    "authorized_consumers": {
      "stackAlerts": {
        "read": true,
        "all": true
      },
      "alerts": {
        "read": true,
        "all": true
      }
    },
    "auto_recover_alerts": true,
    "category": "management",
    "default_action_group_id": "threshold met",
    "does_set_recovery_context": true,
    "enabled_in_license": true,
    "fieldsForAAD": [],
    "has_alerts_mappings": true,
    "has_fields_for_a_a_d": true,
    "id": ".index-threshold",
    "is_internally_managed": false,
    "is_exportable": true,
    "minimum_license_required": "basic",
    "name": "Index threshold",
    "producer": "stackAlerts",
    "recovery_action_group": {
      "id": "recovered",
      "name": "Recovered"
    },
    "rule_task_timeout": "5m"
  },
