[
    {
        "name": "editor",
        "description": "Grants full access to all features in Kibana (including Solutions) and read-only access to data indices.",
        "metadata": {
            "_reserved": true
        },
        "transient_metadata": {
            "enabled": true
        },
        "elasticsearch": {
            "cluster": [
                "monitor_inference"
            ],
            "indices": [
                {
                    "names": [
                        "/~(([.]|ilm-history-).*)/"
                    ],
                    "privileges": [
                        "read",
                        "view_index_metadata"
                    ],
                    "allow_restricted_indices": false
                },
                {
                    "names": [
                        "observability-annotations"
                    ],
                    "privileges": [
                        "read",
                        "view_index_metadata",
                        "write"
                    ],
                    "allow_restricted_indices": false
                },
                {
                    "names": [
                        ".slo-observability.*"
                    ],
                    "privileges": [
                        "read",
                        "view_index_metadata",
                        "write",
                        "manage"
                    ],
                    "allow_restricted_indices": false
                },
                {
                    "names": [
                        ".evaluation-*"
                    ],
                    "privileges": [
                        "read",
                        "view_index_metadata",
                        "write"
                    ],
                    "allow_restricted_indices": false
                },
                {
                    "names": [
                        ".siem-signals*",
                        ".lists-*",
                        ".items-*",
                        ".reindexed-v8-siem-signals*",
                        ".reindexed-v8-lists-*",
                        ".reindexed-v8-items-*",
                        ".asset-criticality.asset-criticality-*"
                    ],
                    "privileges": [
                        "read",
                        "view_index_metadata",
                        "write",
                        "maintenance"
                    ],
                    "allow_restricted_indices": false
                },
                {
                    "names": [
                        ".entities.v1.latest.security_*",
                        ".entities.v2.latest.security_*",
                        ".entities.v2.updates.security_*",
                        ".entities.v2.metadata.security_*",
                        ".entity_analytics.monitoring*",
                        ".entity_analytics.entity-leads*",
                        ".entity_analytics.watchlists.*",
                        ".entities.*.history.*"
                    ],
                    "privileges": [
                        "read",
                        "view_index_metadata"
                    ],
                    "allow_restricted_indices": false
                },
                {
                    "names": [
                        ".internal.alerts*",
                        ".reindexed-v8-internal.alerts*",
                        ".alerts*",
                        ".internal.preview.alerts*",
                        ".reindexed-v8-internal.preview.alerts*",
                        ".preview.alerts*",
                        ".internal.adhoc.alerts*",
                        ".adhoc.alerts*"
                    ],
                    "privileges": [
                        "read",
                        "view_index_metadata",
                        "write",
                        "maintenance"
                    ],
                    "allow_restricted_indices": false
                },
                {
                    "names": [
                        "profiling-*",
                        ".profiling-*"
                    ],
                    "privileges": [
                        "read",
                        "view_index_metadata"
                    ],
                    "allow_restricted_indices": false
                }
            ],
            "run_as": []
        },
        "kibana": [
            {
                "base": [
                    "all"
                ],
                "feature": {},
                "spaces": [
                    "*"
                ]
            }
        ],
        "_transform_error": [],
        "_unrecognized_applications": []
    },
    {
        "name": "my_kibana_role",
        "description": "Read logs and use Discover",
        "metadata": {
            "version": 1
        },
        "transient_metadata": {
            "enabled": true
        },
        "elasticsearch": {
            "cluster": [
                "monitor"
            ],
            "indices": [
                {
                    "names": [
                        "logs-*"
                    ],
                    "privileges": [
                        "read",
                        "view_index_metadata"
                    ],
                    "field_security": {
                        "grant": [
                            "*"
                        ],
                        "except": [
                            "secret"
                        ]
                    },
                    "allow_restricted_indices": false
                }
            ],
            "run_as": []
        },
        "kibana": [
            {
                "base": [],
                "feature": {
                    "discover": [
                        "all"
                    ],
                    "dashboard": [
                        "read"
                    ]
                },
                "spaces": [
                    "marketing"
                ]
            },
            {
                "base": [
                    "read"
                ],
                "feature": {},
                "spaces": [
                    "default"
                ]
            }
        ],
        "_transform_error": [],
        "_unrecognized_applications": []
    },
